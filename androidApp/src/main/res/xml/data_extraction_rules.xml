<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. The session file is encrypted with a Keystore key that never leaves
     the device, so a backed-up or transferred copy could not be decrypted. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="maxxing_session.enc" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="maxxing_session.enc" />
    </device-transfer>
</data-extraction-rules>
